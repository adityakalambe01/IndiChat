# Environment Variables for Local Development and Docker Compose

# App Configuration
APP_NAME=IndiChat
VITE_APP_NAME=IndiChat


# Database Selection Flag
# Set USE_DOCKER_POSTGRES=true to use local Docker PostgreSQL container (localhost:5554)
# Set USE_DOCKER_POSTGRES=false (default) to use external/hosted PostgreSQL (e.g. Render, AWS RDS)
USE_DOCKER_POSTGRES=false

# External / Hosted Database (used when USE_DOCKER_POSTGRES=false)
POSTGRES_HOST=your_postgres_hostname
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_SSL=true

# Docker Database (used when USE_DOCKER_POSTGRES=true)
DOCKER_POSTGRES_HOST=localhost
DOCKER_POSTGRES_PORT=5554
DOCKER_POSTGRES_DB=chat_platform
DOCKER_POSTGRES_USER=postgres
DOCKER_POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
PORT=8080
SERVER_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=chat-attachments
S3_REGION=us-east-1

# Web Frontend
WEB_PORT=5174
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
