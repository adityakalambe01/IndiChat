{
  "name": "chat-platform",
  "version": "1.0.0",
  "private": true,
  "description": "IndiChat messaging platform monorepo (Web, Mobile, Backend)",
  "author": "Aditya Kalambe (https://github.com/adityakalambe01)",
  "license": "MIT",

  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'); if(!fs.existsSync('node_modules/expo') && fs.existsSync('apps/mobile/node_modules/expo')) { try { fs.symlinkSync('../apps/mobile/node_modules/expo','node_modules/expo'); } catch(e){} }\"",
    "web:dev": "npm --workspace=apps/web run dev",
    "web:build": "npm --workspace=apps/web run build",
    "db:seed": "node scripts/seed-db.js",
    "verify:users": "node scripts/verify_all_demo_users.js",
    "verify:ws": "node scripts/verify_ws.js",
    "sync:logos": "node scripts/sync-logos.js",
    "mobile:start": "NODE_PATH=apps/mobile/node_modules:node_modules npm --workspace=apps/mobile run start",
    "mobile:android": "NODE_PATH=apps/mobile/node_modules:node_modules npm --workspace=apps/mobile run android",
    "mobile:ios": "NODE_PATH=apps/mobile/node_modules:node_modules npm --workspace=apps/mobile run ios",
    "build:android": "node scripts/build-android.js",
    "build:android:apk": "node scripts/build-android.js --apk",
    "build:android:bundle": "node scripts/build-android.js --bundle",
    "build:ios": "node scripts/build-ios.js",
    "build:ios:sim": "node scripts/build-ios.js --sim",
    "build:ios:archive": "node scripts/build-ios.js --archive",
    "mobile:build": "node scripts/build-android.js",
    "mobile:build:apk": "node scripts/build-android.js --apk",
    "mobile:build:bundle": "node scripts/build-android.js --bundle",
    "mobile:build:ios": "node scripts/build-ios.js",
    "desktop:linux": "npm --workspace=apps/desktop run dev",
    "desktop:start": "npm --workspace=apps/desktop run start",
    "build:linux": "node scripts/build-linux.js",
    "build:linux:appimage": "node scripts/build-linux.js --appimage",
    "build:linux:deb": "node scripts/build-linux.js --deb",
    "build:linux:snap": "node scripts/build-linux.js --snap",
    "build:linux:tar": "node scripts/build-linux.js --tar",
    "build:linux:all": "node scripts/build-linux.js --all",
    "backend:build": "docker run --rm -v $(pwd)/backend:/app -w /app -v $HOME/.m2:/root/.m2 maven:3.9-eclipse-temurin-21 mvn clean package -DskipTests",
    "backend:test": "docker run --rm -v $(pwd)/backend:/app -w /app -v $HOME/.m2:/root/.m2 maven:3.9-eclipse-temurin-21 mvn test",
    "backend:run": "java -jar backend/target/chat-backend-1.0.0.jar"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "overrides": {
    "query-string": "^7.1.3"
  }
}
