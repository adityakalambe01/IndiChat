{
  "appId": "org.indichat.IndiChat",
  "productName": "IndiChat",
  "executableName": "indichat",
  "electronVersion": "33.4.11",
  "npmRebuild": false,
  "copyright": "Copyright © 2026 Aditya Kalambe",
  "directories": {
    "output": "dist-bin",
    "buildResources": "assets"
  },
  "files": [
    "src/**/*",
    "dist-web/**/*",
    "assets/**/*",
    "package.json"
  ],
  "linux": {
    "maintainer": "Aditya Kalambe <aditya@indichat.com>",
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] },
      { "target": "tar.gz", "arch": ["x64"] }
    ],
    "category": "Network;Chat;InstantMessaging;",
    "icon": "assets/icons",
    "synopsis": "Production-grade Real-Time Messaging Client",
    "description": "IndiChat is a real-time messaging application with instant delivery ticks, audio and video calls, and end-to-end media sharing.",
    "artifactName": "IndiChat-${version}.${ext}"
  },
  "deb": {
    "priority": "optional",
    "packageCategory": "net",
    "artifactName": "indichat_${version}_${arch}.${ext}",
    "depends": [
      "libnotify4",
      "libxtst6",
      "libnss3",
      "libasound2 (>= 1.0.16) | libasound2t64"
    ]
  },
  "appImage": {
    "license": "../../LICENSE",
    "artifactName": "IndiChat-${version}.${ext}"
  },
  "win": {
    "icon": "assets/icon.ico",
    "target": ["nsis", "portable"],
    "artifactName": "IndiChat-Setup-${version}.${ext}"
  }
}
