{
  "expo": {
    "name": "IndiChat",
    "slug": "indichat-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111b21"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "IndiChat uses your contacts to find friends who are already on IndiChat. Your contacts are not stored on our servers."
      }
    },
    "android": {
      "package": "com.indichat.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111b21"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00a884"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "IndiChat uses your contacts to find friends who are already on IndiChat. Your contacts are not stored on our servers."
        }
      ]
    ],
    "scheme": "indichat",
    "newArchEnabled": true
  }
}
